diff --git a/src/ts/multiplayer/Multiplayer.ts b/src/ts/multiplayer/Multiplayer.ts
new file mode 100644
index 0000000..6a313e5
--- /dev/null
+++ b/src/ts/multiplayer/Multiplayer.ts
@@ -0,0 +1,182 @@
+import * as THREE from 'three';
+import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader';
+import { World } from '../world/World';
+import { Character } from '../characters/Character';
+import { IUpdatable } from '../interfaces/IUpdatable';
+import { RemotePlayer } from './RemotePlayer';
+
+/**
+ * Presence-only multiplayer. Each client reports where its own character is and what it is
+ * doing, and draws everyone else as non-interactive ghosts. Gameplay itself is untouched.
+ *
+ * Server address: ?server=ws://host:port in the page URL, or window.SKETCHBOOK_SERVER,
+ * otherwise ws(s)://<page hostname>:8081.
+ */
+export class Multiplayer implements IUpdatable
+{
+	public updateOrder: number = 10;
+
+	private world: World;
+	private socket: WebSocket;
+	private players: { [id: number]: RemotePlayer } = {};
+	private pending: any[] = [];
+	private characterGltf: any;
+	private sendTimer: number = 0;
+	private sendInterval: number = 1 / 20;
+	private retryDelay: number = 2000;
+	private warned: boolean = false;
+
+	private tmpPos: THREE.Vector3 = new THREE.Vector3();
+	private tmpQuat: THREE.Quaternion = new THREE.Quaternion();
+
+	constructor(world: World, characterModelPath: string = 'build/assets/boxman.glb')
+	{
+		this.world = world;
+
+		new GLTFLoader().load(characterModelPath, (gltf) =>
+		{
+			this.characterGltf = gltf;
+			// Handle anything that arrived while the model was loading
+			const queued = this.pending;
+			this.pending = [];
+			queued.forEach((msg) => this.handleMessage(msg));
+		}, undefined, (error) => console.error('Multiplayer: could not load character model', error));
+
+		this.connect();
+	}
+
+	public update(timeStep: number, unscaledTimeStep: number): void
+	{
+		// Ghosts follow real time, so they don't slow down when the local player uses slow motion
+		const dt = Math.min(unscaledTimeStep, 0.1);
+		for (const id in this.players) this.players[id].update(dt);
+
+		this.sendTimer += dt;
+		if (this.sendTimer >= this.sendInterval)
+		{
+			this.sendTimer = 0;
+			this.sendLocalState();
+		}
+	}
+
+	private getServerUrl(): string
+	{
+		const param = new URLSearchParams(window.location.search).get('server');
+		if (param) return param;
+		if ((window as any).SKETCHBOOK_SERVER) return (window as any).SKETCHBOOK_SERVER;
+		const protocol = window.location.protocol === 'https:' ? 'wss' : 'ws';
+		return protocol + '://' + (window.location.hostname || 'localhost') + ':8081';
+	}
+
+	private connect(): void
+	{
+		let socket: WebSocket;
+		try
+		{
+			socket = new WebSocket(this.getServerUrl());
+		}
+		catch (e)
+		{
+			this.scheduleReconnect();
+			return;
+		}
+		this.socket = socket;
+
+		socket.onopen = () =>
+		{
+			this.retryDelay = 2000;
+			this.warned = false;
+		};
+		socket.onmessage = (event) =>
+		{
+			let msg;
+			try { msg = JSON.parse(event.data); } catch (e) { return; }
+			if (this.characterGltf) this.handleMessage(msg);
+			else this.pending.push(msg);
+		};
+		socket.onclose = () =>
+		{
+			this.clearPlayers();
+			this.scheduleReconnect();
+		};
+		socket.onerror = () =>
+		{
+			if (!this.warned)
+			{
+				console.info('Multiplayer: server not reachable at ' + this.getServerUrl() + ' (will keep retrying). Start it with "npm run server".');
+				this.warned = true;
+			}
+		};
+	}
+
+	private scheduleReconnect(): void
+	{
+		setTimeout(() => this.connect(), this.retryDelay);
+		this.retryDelay = Math.min(this.retryDelay * 1.5, 15000);
+	}
+
+	private handleMessage(msg: any): void
+	{
+		switch (msg.type)
+		{
+			case 'welcome':
+				this.clearPlayers();
+				msg.players.forEach((p: any) =>
+				{
+					this.addPlayer(p.id, p.name, p.hue);
+					if (p.state) this.players[p.id].setState(p.state.s, p.state.a);
+				});
+				break;
+			case 'join':
+				this.addPlayer(msg.id, msg.name, msg.hue);
+				break;
+			case 'state':
+				if (!this.players[msg.id]) this.addPlayer(msg.id, 'Player ' + msg.id, 200);
+				this.players[msg.id].setState(msg.s, msg.a);
+				break;
+			case 'name':
+				if (this.players[msg.id]) this.players[msg.id].setName(msg.name);
+				break;
+			case 'leave':
+				this.removePlayer(msg.id);
+				break;
+		}
+	}
+
+	private addPlayer(id: number, name: string, hue: number): void
+	{
+		if (this.players[id]) return;
+		this.players[id] = new RemotePlayer(this.world, this.characterGltf, id, name, hue);
+	}
+
+	private removePlayer(id: number): void
+	{
+		if (!this.players[id]) return;
+		this.players[id].dispose();
+		delete this.players[id];
+	}
+
+	private clearPlayers(): void
+	{
+		for (const id in this.players) this.removePlayer(Number(id));
+	}
+
+	private sendLocalState(): void
+	{
+		if (!this.socket || this.socket.readyState !== WebSocket.OPEN) return;
+
+		const receiver = this.world.inputManager.inputReceiver;
+		if (!(receiver instanceof Character)) return;
+
+		// World-space values so a character sitting inside a vehicle is reported correctly too
+		receiver.getWorldPosition(this.tmpPos);
+		receiver.getWorldQuaternion(this.tmpQuat);
+
+		const r = (n: number) => Math.round(n * 1000) / 1000;
+		this.socket.send(JSON.stringify({
+			type: 'state',
+			s: [r(this.tmpPos.x), r(this.tmpPos.y), r(this.tmpPos.z), r(this.tmpQuat.x), r(this.tmpQuat.y), r(this.tmpQuat.z), r(this.tmpQuat.w)],
+			a: receiver.currentAnimation || 'idle'
+		}));
+	}
+}
diff --git a/src/ts/multiplayer/RemotePlayer.ts b/src/ts/multiplayer/RemotePlayer.ts
new file mode 100644
index 0000000..8bb88a6
--- /dev/null
+++ b/src/ts/multiplayer/RemotePlayer.ts
@@ -0,0 +1,171 @@
+import * as THREE from 'three';
+import { SkeletonUtils } from 'three/examples/jsm/utils/SkeletonUtils';
+import { World } from '../world/World';
+
+/**
+ * A visual-only stand-in for another player's character.
+ * No physics and no input: it just mirrors the state received from the server.
+ */
+export class RemotePlayer
+{
+	public id: number;
+	public root: THREE.Group = new THREE.Group();
+	public lastUpdate: number = 0;
+
+	private world: World;
+	private mixer: THREE.AnimationMixer;
+	private animations: THREE.AnimationClip[];
+	private currentAction: THREE.AnimationAction;
+	private currentClipName: string;
+	private nameSprite: THREE.Sprite;
+
+	private targetPosition: THREE.Vector3 = new THREE.Vector3();
+	private targetQuaternion: THREE.Quaternion = new THREE.Quaternion();
+	private hasState: boolean = false;
+
+	constructor(world: World, gltf: any, id: number, name: string, hue: number)
+	{
+		this.world = world;
+		this.id = id;
+		this.animations = gltf.animations;
+
+		// Same hierarchy the real Character uses: capsule center at root, model offset below it
+		const modelContainer = new THREE.Group();
+		modelContainer.position.y = -0.57;
+		const model = SkeletonUtils.clone(gltf.scene) as THREE.Object3D;
+		modelContainer.add(model);
+		this.root.add(modelContainer);
+
+		// Give every player their own tint, with their own material copies
+		const tint = new THREE.Color().setHSL(hue / 360, 0.55, 0.75);
+		model.traverse((child: any) =>
+		{
+			if (child.isMesh)
+			{
+				child.castShadow = true;
+				child.receiveShadow = true;
+				child.frustumCulled = false;
+				if (child.material)
+				{
+					child.material = child.material.clone();
+					if (child.material.color) child.material.color.multiply(tint);
+					world.sky.csm.setupMaterial(child.material);
+				}
+			}
+		});
+
+		this.mixer = new THREE.AnimationMixer(model);
+
+		this.nameSprite = this.createNameSprite(name);
+		this.nameSprite.position.y = 1.2;
+		this.root.add(this.nameSprite);
+
+		this.root.visible = false;
+		world.graphicsWorld.add(this.root);
+	}
+
+	public setName(name: string): void
+	{
+		this.root.remove(this.nameSprite);
+		this.disposeSprite(this.nameSprite);
+		this.nameSprite = this.createNameSprite(name);
+		this.nameSprite.position.y = 1.2;
+		this.root.add(this.nameSprite);
+	}
+
+	public setState(s: number[], animation: string): void
+	{
+		this.targetPosition.set(s[0], s[1], s[2]);
+		this.targetQuaternion.set(s[3], s[4], s[5], s[6]);
+		this.lastUpdate = performance.now();
+
+		if (!this.hasState)
+		{
+			// First packet: snap into place instead of flying in from the origin
+			this.root.position.copy(this.targetPosition);
+			this.root.quaternion.copy(this.targetQuaternion);
+			this.hasState = true;
+		}
+
+		this.playAnimation(animation);
+	}
+
+	public update(dt: number): void
+	{
+		if (!this.hasState) return;
+
+		const stale = performance.now() - this.lastUpdate > 3000;
+		this.root.visible = !stale;
+		if (stale) return;
+
+		// Frame-rate independent smoothing between network updates
+		const k = 1 - Math.exp(-dt * 18);
+		if (this.root.position.distanceToSquared(this.targetPosition) > 25)
+		{
+			this.root.position.copy(this.targetPosition); // teleport / respawn
+		}
+		else
+		{
+			this.root.position.lerp(this.targetPosition, k);
+		}
+		this.root.quaternion.slerp(this.targetQuaternion, k);
+
+		this.mixer.update(dt);
+	}
+
+	public dispose(): void
+	{
+		this.world.graphicsWorld.remove(this.root);
+		this.mixer.stopAllAction();
+		this.disposeSprite(this.nameSprite);
+		this.root.traverse((child: any) =>
+		{
+			if (child.isMesh && child.material) child.material.dispose();
+		});
+	}
+
+	private playAnimation(clipName: string): void
+	{
+		if (clipName === this.currentClipName) return;
+
+		const clip = THREE.AnimationClip.findByName(this.animations, clipName);
+		if (!clip) return;
+
+		const next = this.mixer.clipAction(clip);
+		next.reset().setEffectiveWeight(1).fadeIn(0.15).play();
+		if (this.currentAction) this.currentAction.fadeOut(0.15);
+
+		this.currentAction = next;
+		this.currentClipName = clipName;
+	}
+
+	private createNameSprite(name: string): THREE.Sprite
+	{
+		const canvas = document.createElement('canvas');
+		canvas.width = 256;
+		canvas.height = 64;
+		const ctx = canvas.getContext('2d');
+		ctx.font = 'bold 32px sans-serif';
+		ctx.textAlign = 'center';
+		ctx.textBaseline = 'middle';
+		ctx.lineWidth = 6;
+		ctx.strokeStyle = 'rgba(0,0,0,0.7)';
+		ctx.strokeText(name, 128, 32);
+		ctx.fillStyle = '#ffffff';
+		ctx.fillText(name, 128, 32);
+
+		const texture = new THREE.CanvasTexture(canvas);
+		const material = new THREE.SpriteMaterial({ map: texture, depthTest: false, transparent: true });
+		const sprite = new THREE.Sprite(material);
+		sprite.scale.set(1.6, 0.4, 1);
+		sprite.renderOrder = 999;
+		return sprite;
+	}
+
+	private disposeSprite(sprite: THREE.Sprite): void
+	{
+		const mat = sprite.material as THREE.SpriteMaterial;
+		if (mat.map) mat.map.dispose();
+		mat.dispose();
+	}
+}
